// ১. চ্যানেল জয়েন চেক করার ফাংশন
function isUserSubscribed($apiUrl, $channelUsername, $userId) {
    $url = $apiUrl . "/getChatMember?chat_id=" . $channelUsername . "&user_id=" . $userId;
    $response = @file_get_contents($url);
    $result = json_decode($response, true);

    if ($result && isset($result['ok']) && $result['ok']) {
        $status = $result['result']['status'];
        return in_array($status, ['member', 'administrator', 'creator']);
    }
    return false;
}

// ২. Telegram Bot Message Handling
if ($update) {
    if (isset($update['message'])) {
        $chatId = $update['message']['chat']['id'];
        $userId = $update['message']['from']['id'];
        $text = $update['message']['text'] ?? '';
    } elseif (isset($update['callback_query'])) {
        $chatId = $update['callback_query']['message']['chat']['id'];
        $userId = $update['callback_query']['from']['id'];
        $callbackData = $update['callback_query']['data'];
    }

    if (isset($text) && strpos($text, '/start') === 0) {
        // রেফার আইডি এক্সট্র্যাক্ট করা
        $param = trim(str_replace('/start', '', $text));
        
        $isJoined = isUserSubscribed($apiUrl, $channelUsername, $userId);

        if ($isJoined) {
            sendMiniAppButton($apiUrl, $chatId, "✅ আপনার একাউন্ট ভেরিফাইড! নিচের বাটনে ক্লিক করে Mini App চালু করুন।");
        } else {
            sendForceJoinMessage($apiUrl, $chatId, $channelUsername);
        }
        exit;
    }

    if (isset($callbackData) && $callbackData === 'check_subscription') {
        file_get_contents($apiUrl . "/answerCallbackQuery?callback_query_id=" . $update['callback_query']['id']);
        
        $isJoined = isUserSubscribed($apiUrl, $channelUsername, $userId);
        if ($isJoined) {
            sendMiniAppButton($apiUrl, $chatId, "🎉 ধন্যবাদ! জয়েনিং সফল হয়েছে। এখন আপনি Mini App ব্যবহার করতে পারবেন।");
        } else {
            sendForceJoinMessage($apiUrl, $chatId, $channelUsername, "⚠️ আপনি এখনও চ্যানেলে জয়েন করেননি! দয়া করে আগে জয়েন করুন।");
        }
        exit;
    }
}

// মেসেজ পাঠানোর হেল্পার ফাংশনসমূহ
function sendForceJoinMessage($apiUrl, $chatId, $channelUsername, $customMsg = "") {
    $cleanUsername = str_replace('@', '', $channelUsername);
    $msg = $customMsg ? $customMsg : "⚠️ **বিজ্ঞপ্তি:** বটের মিনি অ্যাপ ব্যবহারের আগে আমাদের অফিসিয়াল চ্যানেলে জয়েন করা বাধ্যতামূলক।";
    
    $keyboard = [
        'inline_keyboard' => [
            [['text' => '📢 Join Channel', 'url' => 'https://t.me/' . $cleanUsername]],
            [['text' => '✅ Verify / Check', 'callback_data' => 'check_subscription']]
        ]
    ];
    sendMessage($apiUrl, $chatId, $msg, $keyboard);
}

function sendMiniAppButton($apiUrl, $chatId, $text) {
    // এই ওয়েবসাইটের বর্তমান URL অটোমেটিক ডিটেক্ট করবে
    $actualLink = (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on' ? "https" : "http") . "://$_SERVER[HTTP_HOST]$_SERVER[REQUEST_URI]";
    
    $keyboard = [
        'inline_keyboard' => [
            [['text' => '🚀 Open Mini App', 'web_app' => ['url' => $actualLink]]]
        ]
    ];
    sendMessage($apiUrl, $chatId, $text, $keyboard);
}

function sendMessage($apiUrl, $chatId, $text, $keyboard = null) {
    $data = [
        'chat_id' => $chatId,
        'text' => $text,
        'parse_mode' => 'Markdown'
    ];
    if ($keyboard) {
        $data['reply_markup'] = json_encode($keyboard);
    }
    
    $options = [
        'http' => [
            'header'  => "Content-type: application/x-www-form-urlencoded\r\n",
            'method'  => 'POST',
            'content' => http_build_query($data)
        ]
    ];
    $context = stream_context_create($options);
    @file_get_contents($apiUrl . "/sendMessage", false, $context);
}
